{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./pub/js",
    "rootDir": "./src",
    "sourceMap": false,
    "lib": ["ESNext", "DOM", "WebWorker"]
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "node_modules",
    "src/**/*.test.ts",
    "src/**/*.vitest.test.ts",
    "vitest.config.ts",
    "src/vitest.setup.ts"
  ]
}
