{
  "name": "python-to-javascript-src",
  "version": "1.0.0",
  "type": "module",
  "description": "Python to JavaScript transpiler source",
  "main": "main.js",
  "scripts": {
    "test": "vitest run --coverage",
    "test:ui": "npx playwright test src/ui.test.ts src/infinite.test.ts src/diagnose.test.ts src/test_loops_ui.test.ts",
    "serve": "node src/serve.js",
    "coverage": "c8 report --reporter=text"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@types/jsdom": "^28.0.1",
    "@vitest/coverage-v8": "^4.1.6",
    "c8": "^11.0.0",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "http-server": "^14.1.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.3",
    "vitest": "^4.1.6"
  }
}
