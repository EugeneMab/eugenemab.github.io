    "vitest": "^1.0.0",
    "c8": "^8.0.0",
    "serve": "^14.2.0",
    "prettier": "^3.0.0",
    "eslint": "^8.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0"
  },
  "dependencies": {
    "wabt": "^1.0.35"
  }
}
